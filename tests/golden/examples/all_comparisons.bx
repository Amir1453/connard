// Test string of comparisons
extern def print(n : int);

def main() {
  var a = 5 : int;
  var b = 10 : int;
  var c = 5 : int;
  
  if (a == c) {
    print(1);
  }
  
  if (a != b) {
    print(2);
  }
  
  if (a < b) {
    print(3);
  }
  
  if (a <= c) {
    print(4);
  }
  
  if (b > a) {
    print(5);
  }
  
  if (c >= a) {
    print(6);
  }
}
