// All variables interdependent with cross-updates
extern def print(n : int);

def main() {
    var a = 1 : int;
    var b = 1 : int;
    var c = 1 : int;
    var d = 1 : int;
    var e = 1 : int;
    var f = 1 : int;
    var i = 0 : int;
    
    while (i < 12) {
        if (i % 4 == 0) {
            a = b + c;
            b = c + d;
            c = d + e;
            d = e + f;
            e = f + a;
            f = a + b;
        } else {
            if (i % 4 == 1) {
                a = a + f;
                b = b + e;
                c = c + d;
                if (a > 50) {
                    a = a - 30;
                    b = b + 5;
                }
                if (c > 50) {
                    c = c - 30;
                    d = d + 5;
                }
            } else {
                if (i % 4 == 2) {
                    d = a + b;
                    e = b + c;
                    f = c + a;
                    if (e > 100) {
                        e = e / 2;
                        f = f + 10;
                    }
                } else {
                    a = d - b;
                    b = e - c;
                    c = f - d;
                    d = d + 1;
                    e = e + 2;
                    f = f + 3;
                    if (a < 0) {
                        a = 0 - a;
                    }
                    if (b < 0) {
                        b = 0 - b;
                    }
                    if (c < 0) {
                        c = 0 - c;
                    }
                }
            }
        }
        i = i + 1;
    }
    
    print(a);
    print(b);
    print(c);
    print(d);
    print(e);
    print(f);
}
