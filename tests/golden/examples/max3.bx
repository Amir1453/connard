// Test ternary-like pattern with if-else
extern def print(n : int);

def max3(a, b, c : int) : int {
  if (a > b) {
    if (a > c) {
      return a;
    } else {
      return c;
    }
  } else {
    if (b > c) {
      return b;
    } else {
      return c;
    }
  }
  return 0;
}

def main() {
  print(max3(5, 10, 3));
  print(max3(15, 10, 20));
  print(max3(8, 12, 7));
  print(max3(4, 4, 4));
}
