// Test multiple returns in different branches
extern def print(n : int);

def classify(n : int) : int {
  if (n < 0) {
    return -1;
  }
  if (n == 0) {
    return 0;
  }
  if (n < 10) {
    return 1;
  }
  if (n < 100) {
    return 2;
  }
  return 3;
}

def main() {
  print(classify(-5));
  print(classify(0));
  print(classify(7));
  print(classify(42));
  print(classify(150));
}
