extern def print(n : int);
extern def print(b : bool);

// Test complex control flow with multiple procedures
def is_even(n : int) : bool {
  if (n % 2 == 0) {
    return true;
  } else {
    return false;
  }
  return false;
}

def sum_evens(start, end : int) : int {
  var sum = 0 : int;
  while (start <= end) {
    if (is_even(start)) {
      sum = sum + start;
    }
    start = start + 1;
  }
  return sum;
}

def main() {
  print(is_even(4));
  print(is_even(7));
  print(sum_evens(1, 10));
  print(sum_evens(5, 15));
}
