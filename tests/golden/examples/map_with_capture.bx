extern def print(n : int);

def map_and_sum(f : function(int) -> int, a : int, b : int, c : int) : int {
    return f(a) + f(b) + f(c);
}

def main() {
    var base = 1 : int;
    
    def add_base(n : int) : int {
        return n + base;
    }
    
    print(map_and_sum(add_base, 1, 2, 3));
    
    base = 10;
    print(map_and_sum(add_base, 1, 2, 3));
}
