extern def print(n : int);

def apply(f : function(int, int) -> int, a : int, b : int) : int {
    return f(a, b);
}

def main() {
    var multiplier = 10 : int;
    
    def complex_func(x : int, y : int) : int {
        return (x + y) * multiplier;
    }
    
    print(apply(complex_func, 3, 7));
    
    multiplier = 5;
    print(apply(complex_func, 3, 7));
}
