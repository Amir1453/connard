extern def print(n : int);

def apply_many(f : function(int) -> int, g : function(int) -> int, h : function(int) -> int, x : int) : int {
    return h(g(f(x)));
}

def main() {
    def inc(n : int) : int { return n + 1; }
    def double(n : int) : int { return n * 2; }
    def square(n : int) : int { return n * n; }
    
    print(apply_many(inc, double, square, 3));
}
