// Deeply nested conditionals with many merge points
extern def print(n : int);

def main() {
    var v1 = 1 : int;
    var v2 = 2 : int;
    var v3 = 3 : int;
    var v4 = 4 : int;
    var v5 = 5 : int;
    var selector = 0 : int;
    
    while (selector < 20) {
        if (selector % 5 == 0) {
            if (v1 < v2) {
                if (v2 < v3) {
                    v1 = v1 + v2;
                    v2 = v2 + v3;
                } else {
                    v1 = v1 - 1;
                    v3 = v3 + 1;
                }
            } else {
                if (v3 < v4) {
                    v2 = v2 + v3;
                    v3 = v3 + v4;
                } else {
                    v2 = v2 - 1;
                    v4 = v4 + 1;
                }
            }
        } else {
            if (selector % 5 == 1) {
                if (v4 < v5) {
                    if (v1 < v5) {
                        v4 = v4 + v5;
                        v5 = v5 + v1;
                    } else {
                        v4 = v4 - 1;
                        v1 = v1 + 2;
                    }
                } else {
                    if (v2 < v5) {
                        v5 = v5 + v2;
                        v2 = v2 + 3;
                    } else {
                        v5 = v5 - 2;
                        v2 = v2 - 1;
                    }
                }
            } else {
                if (selector % 5 == 2) {
                    if (v1 + v2 > v3 + v4) {
                        v1 = v1 + 1;
                        v2 = v2 + 2;
                    } else {
                        v3 = v3 + 1;
                        v4 = v4 + 2;
                    }
                } else {
                    if (selector % 5 == 3) {
                        if (v2 + v3 > v4 + v5) {
                            v2 = v2 + 3;
                            v3 = v3 + 4;
                        } else {
                            v4 = v4 + 3;
                            v5 = v5 + 4;
                        }
                    } else {
                        v1 = v1 + v5;
                        v5 = v5 + 1;
                    }
                }
            }
        }
        selector = selector + 1;
    }
    
    print(v1);
    print(v2);
    print(v3);
    print(v4);
    print(v5);
}
