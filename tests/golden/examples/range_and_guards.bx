// Test boolean short-circuit patterns with complex expressions
extern def print(n : int);

def is_in_range(x, low, high : int) : int {
  if (x >= low) {
    if (x <= high) {
      return 1;
    }
  }
  return 0;
}

def safe_divide(a, b : int) : int {
  if (b != 0) {
    return a / b;
  }
  return -1;
}

def main() {
  print(is_in_range(5, 1, 10));
  print(is_in_range(15, 1, 10));
  print(is_in_range(0, 1, 10));
  
  print(safe_divide(20, 4));
  print(safe_divide(100, 5));
  print(safe_divide(10, 0));
  
  var x = 7 : int;
  var result = is_in_range(x, 5, 10) : int;
  if (result == 1) {
    print(safe_divide(x, 2));
  } else {
    print(-999);
  }
}
