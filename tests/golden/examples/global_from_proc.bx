extern def print(n : int);

// Test globals accessed from procedures
var counter = 0 : int;

def increment() {
  counter = counter + 1;
}

def double_counter() {
  counter = counter * 2;
}

def main() {
  print(counter);
  increment();
  print(counter);
  increment();
  print(counter);
  double_counter();
  print(counter);
  increment();
  print(counter);
}
