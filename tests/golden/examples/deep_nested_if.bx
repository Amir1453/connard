// Test deeply nested conditional logic
extern def print(n : int);

def classify_number(n : int) : int {
  if (n > 0) {
    if (n > 100) {
      if (n > 1000) {
        return 4;
      } else {
        return 3;
      }
    } else {
      if (n > 10) {
        return 2;
      } else {
        return 1;
      }
    }
  } else {
    if (n == 0) {
      return 0;
    } else {
      if (n < -100) {
        return -3;
      } else {
        if (n < -10) {
          return -2;
        } else {
          return -1;
        }
      }
    }
  }
  return 0;
}

def main() {
  print(classify_number(5));
  print(classify_number(50));
  print(classify_number(500));
  print(classify_number(5000));
  print(classify_number(0));
  print(classify_number(-5));
  print(classify_number(-50));
  print(classify_number(-500));
}
