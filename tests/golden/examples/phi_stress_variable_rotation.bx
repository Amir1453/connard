// Multiple variables that swap and update in complex patterns
extern def print(n : int);

def main() {
    var x = 10 : int;
    var y = 20 : int;
    var z = 30 : int;
    var temp = 0 : int;
    var i = 0 : int;
    
    while (i < 10) {
        if (i % 3 == 0) {
            temp = x;
            x = y;
            y = z;
            z = temp;
        } else {
            if (i % 3 == 1) {
                temp = x;
                x = z;
                z = y;
                y = temp;
            } else {
                x = x + y;
                y = y + z;
                z = z + x;
            }
        }
        
        if (x > 100) {
            x = x - 50;
        }
        if (y > 100) {
            y = y - 50;
        }
        if (z > 100) {
            z = z - 50;
        }
        
        i = i + 1;
    }
    
    print(x);
    print(y);
    print(z);
}
