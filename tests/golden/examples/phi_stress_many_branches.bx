// Switch-like pattern with many branches
extern def print(n : int);

def main() {
    var x = 0: int;
    var result = 0: int;
    
    x = 5;
    result = 0;
    
    if (x == 0) {
        result = 10;
    } else {
        if (x == 1) {
            result = 20;
        } else {
            if (x == 2) {
                result = 30;
            } else {
                if (x == 3) {
                    result = 40;
                } else {
                    if (x == 4) {
                        result = 50;
                    } else {
                        if (x == 5) {
                            result = 60;
                        } else {
                            result = 70;
                        }
                    }
                }
            }
        }
    }
    
    print(result);
}
