extern def print(n : int);

def main() {
    var counter = 0 : int;
    
    def level1() {
        counter = counter + 1;
        
        def level2() {
            counter = counter + 10;
            
            def level3() {
                counter = counter + 100;
            }
            
            level3();
        }
        
        level2();
    }
    
    level1();
    print(counter);
    level1();
    print(counter);
}
