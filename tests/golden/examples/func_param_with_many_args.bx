extern def print(n : int);

def transform(f : function(int) -> int, arr_len : int, val1 : int, val2 : int, val3 : int) {
    print(f(val1));
    print(f(val2));
    print(f(val3));
}

def main() {
    var offset = 100 : int;
    
    def add_offset(n : int) : int {
        return n + offset;
    }
    
    transform(add_offset, 3, 1, 2, 3);
    
    offset = 50;
    transform(add_offset, 3, 4, 5, 6);
}
