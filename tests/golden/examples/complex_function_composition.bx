extern def print(n : int);

def compute(f : function(int, int) -> int, g : function(int) -> int, x : int, y : int) : int {
    return f(g(x), g(y));
}

def main() {
    var mult = 2 : int;
    
    def add(a : int, b : int) : int {
        return a + b;
    }
    
    def times_mult(n : int) : int {
        return n * mult;
    }
    
    print(compute(add, times_mult, 3, 4));
}
