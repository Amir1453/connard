extern def print(n : int);

def apply(f : function(int) -> int, x : int) : int {
    return f(x);
}

def main() {
    var captured = 5 : int;
    
    def use_capture(n : int) : int {
        return n + captured;
    }
    
    print(apply(use_capture, 10));
    captured = 20;
    print(apply(use_capture, 10));
}
