// Test factorial with while
extern def print(n : int);

def factorial(n : int) : int {
  var result = 1 : int;
  var i = n : int;
  while (i > 0) {
    result = result * i;
    i = i - 1;
  }
  return result;
}

def main() {
  print(factorial(5));
  print(factorial(6));
  print(factorial(1));
  print(factorial(0));
}
