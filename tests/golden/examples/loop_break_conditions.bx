// Test loops with complex break conditions
extern def print(n : int);

def sum_until_threshold(max_val : int) : int {
  var sum = 0 : int;
  var i = 1 : int;
  while (true) {
    sum = sum + i;
    if (sum >= max_val) {
      break;
    }
    i = i + 1;
  }
  return sum;
}

def count_down_skip_evens(start : int) {
  var n = start : int;
  while (true) {
    if (n <= 0) {
      break;
    }
    if (n % 2 == 0) {
      n = n - 1;
    } else {
      print(n);
      n = n - 1;
    }
  }
}

def main() {
  print(sum_until_threshold(10));
  print(sum_until_threshold(50));
  print(sum_until_threshold(100));
  count_down_skip_evens(10);
}
