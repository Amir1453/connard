extern def print(n : int);

def main() {
    var x = 1 : int;
    
    def level1() {
        var y = 2 : int;
        
        def level2() {
            var z = 3 : int;
            
            def level3() {
                print(x);
                print(y);
                print(z);
                x = 10;
                y = 20;
                z = 30;
            }
            
            level3();
            print(z);
        }
        
        level2();
        print(y);
    }
    
    level1();
    print(x);
}
