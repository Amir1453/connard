extern def print(n : int);

def identity(f : function(int) -> int, x : int) : int {
    return f(x);
}

def main() {
    var base = 10 : int;
    
    def add_base(n : int) : int {
        return n + base;
    }
    
    base = 5;
    print(identity(add_base, 7));
    
    base = 20;
    print(identity(add_base, 7));
}
