extern def print(n : int);

def chain(f1 : function(int) -> int, f2 : function(int) -> int, f3 : function(int) -> int, f4 : function(int) -> int, x : int) : int {
    return f4(f3(f2(f1(x))));
}

def main() {
    def inc(n : int) : int { return n + 1; }
    def dbl(n : int) : int { return n * 2; }
    def sqr(n : int) : int { return n * n; }
    def sub(n : int) : int { return n - 3; }
    
    print(chain(inc, dbl, sqr, sub, 2));
}
