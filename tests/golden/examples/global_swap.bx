// Test swapping globals through function calls
extern def print(n : int);

var a = 100 : int;
var b = 200 : int;
var temp = 0 : int;

def save_a() {
  temp = a;
}

def copy_b_to_a() {
  a = b;
}

def restore_to_b() {
  b = temp;
}

def swap() {
  save_a();
  copy_b_to_a();
  restore_to_b();
}

def main() {
  print(a);
  print(b);
  swap();
  print(a);
  print(b);
  swap();
  print(a);
  print(b);
}
