// Complex nested loops with multiple phi merge points
extern def print(n : int);

def main() {
    var x = 0: int;
    var y = 0: int;
    var z = 0: int;
    
    x = 0;
    y = 0;
    z = 0;
    
    while (x < 3) {
        y = 0;
        while (y < 3) {
            if (x == y) {
                z = z + 1;
            } else {
                if (x > y) {
                    z = z + 2;
                } else {
                    z = z + 3;
                }
            }
            y = y + 1;
        }
        x = x + 1;
    }
    
    print(z);
}
