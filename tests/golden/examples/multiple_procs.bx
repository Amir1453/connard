extern def print(n : int);

// Test multiple procedure declarations and calls
def add(a, b : int) : int {
  return a + b;
}

def multiply(x, y : int) : int {
  return x * y;
}

def main() {
  var result1 = add(5, 3) : int;
  var result2 = multiply(4, 7) : int;
  var result3 = add(result1, result2) : int;
  print(result1);
  print(result2);
  print(result3);
}
