// Triple nested loops with complex variable updates creating massive phi nodes
extern def print(n : int);

def main() {
    var i = 0 : int;
    var j = 0 : int;
    var k = 0 : int;
    var a = 0 : int;
    var b = 0 : int;
    var c = 0 : int;
    var d = 0 : int;
    
    while (i < 4) {
        j = 0;
        while (j < 4) {
            k = 0;
            while (k < 4) {
                if (i == j) {
                    if (j == k) {
                        a = a + 1;
                        b = b + 2;
                    } else {
                        a = a + 3;
                        c = c + 4;
                    }
                } else {
                    if (j == k) {
                        b = b + 5;
                        d = d + 6;
                    } else {
                        if (i == k) {
                            c = c + 7;
                            d = d + 8;
                        } else {
                            a = a + 9;
                            b = b + 10;
                            c = c + 11;
                            d = d + 12;
                        }
                    }
                }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    
    print(a);
    print(b);
    print(c);
    print(d);
}
