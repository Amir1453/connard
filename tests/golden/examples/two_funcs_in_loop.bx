extern def print(n : int);

def main() {
    var flag = 1 : int;
    
    while (flag < 4) {
        var local = flag : int;
        
        def show_local() {
            print(local * 100);
        }
        
        def show_flag() {
            print(flag);
        }
        
        show_local();
        show_flag();
        
        flag = flag + 1;
    }
}
