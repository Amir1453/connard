// Test early return in while loop
extern def print(n : int);

def find_divisor(n : int) : int {
  var i = 2 : int;
  while (i < n) {
    if (n % i == 0) {
      return i;
    }
    i = i + 1;
  }
  return n;
}

def main() {
  print(find_divisor(15));
  print(find_divisor(17));
  print(find_divisor(20));
  print(find_divisor(13));
}
