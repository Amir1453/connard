// Multiple paths converging with different variable versions
extern def print(n : int);

def main() {
    var a = 0: int;
    var b = 0: int;
    var c = 0: int;
    
    a = 1;
    b = 2;
    c = 3;
    
    if (a < 5) {
        a = a + 1;
        if (b < 5) {
            b = b + 1;
            if (c < 5) {
                c = c + 1;
            }
        }
    } else {
        if (b > 0) {
            b = b - 1;
            if (c > 0) {
                c = c - 1;
            }
        }
    }
    
    // At this point, a, b, c each have multiple possible versions
    // depending on which path was taken
    
    print(a);
    print(b);
    print(c);
}
