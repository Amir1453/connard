extern def print(n : int);

// Test nested procedure calls
def add(a, b : int) : int {
  return a + b;
}

def multiply(x, y : int) : int {
  return x * y;
}

def compute(a, b, c : int) : int {
  return multiply(add(a, b), c);
}

def main() {
  var result = compute(3, 4, 5) : int;
  print(result);
  print(compute(10, 20, 2));
  print(add(multiply(2, 3), multiply(4, 5)));
}
