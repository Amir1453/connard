extern def print(n : int);

def apply_all(f : function(int) -> void, a : int, b : int, c : int, d : int) {
    f(a);
    f(b);
    f(c);
    f(d);
}

def main() {
    var sum = 0 : int;
    
    def accumulate(n : int) {
        sum = sum + n;
    }
    
    apply_all(accumulate, 10, 20, 30, 40);
    print(sum);
}
