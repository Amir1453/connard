// Test functions with no parameters that use globals
extern def print(n : int);

var counter = 0 : int;
var step_size = 5 : int;

def get_counter() : int {
  return counter;
}

def increment_by_step() {
  counter = counter + step_size;
}

def reset_counter() {
  counter = 0;
}

def double_step() {
  step_size = step_size * 2;
}

def main() {
  print(get_counter());
  increment_by_step();
  print(get_counter());
  increment_by_step();
  print(get_counter());
  double_step();
  increment_by_step();
  print(get_counter());
  reset_counter();
  print(get_counter());
}
