extern def print(n : int);

def repeat(f : function(int) -> int, n : int, x : int) : int {
    if (n == 0) {
        return x;
    } else {
        return repeat(f, n - 1, f(x));
    }
    return 0;
}

def main() {
    def inc(x : int) : int {
        return x + 1;
    }
    
    print(repeat(inc, 5, 1));
}
