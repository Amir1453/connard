// Test modifying global in nested calls
extern def print(n : int);

var total = 0 : int;

def add_to_total(n : int) {
  total = total + n;
}

def process(a, b : int) {
  add_to_total(a);
  add_to_total(b);
}

def main() {
  print(total);
  process(5, 10);
  print(total);
  process(3, 7);
  print(total);
}
