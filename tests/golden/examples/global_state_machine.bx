// Test using globals as a state machine
extern def print(n : int);

var state = 0 : int;
var value = 10 : int;

def increment_state() {
  state = state + 1;
}

def process() {
  if (state == 0) {
    value = value + 10;
  } else {
    if (state == 1) {
      value = value * 2;
    } else {
      if (state == 2) {
        value = value - 5;
      } else {
        value = 0;
      }
    }
  }
}

def step() {
  process();
  increment_state();
}

def main() {
  print(state);
  print(value);
  step();
  print(state);
  print(value);
  step();
  print(state);
  print(value);
  step();
  print(state);
  print(value);
  step();
  print(state);
  print(value);
}
