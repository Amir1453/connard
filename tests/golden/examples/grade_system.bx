// Test complex else-if chains
extern def print(n : int);

def grade(score : int) : int {
  if (score >= 90) {
    return 4;
  } else if (score >= 80) {
    return 3;
  } else if (score >= 70) {
    return 2;
  } else if (score >= 60) {
    return 1;
  } else {
    return 0;
  }
  return 0;
}

def main() {
  print(grade(95));
  print(grade(85));
  print(grade(75));
  print(grade(65));
  print(grade(55));
  print(grade(100));
  print(grade(0));
}
