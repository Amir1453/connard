extern def print(n : int);

def main() {
    var x = 1 : int;
    
    def level1() {
        var x = 2 : int;
        
        def level2() {
            var x = 3 : int;
            
            def level3() {
                var x = 4 : int;
                print(x);
            }
            
            level3();
            print(x);
        }
        
        level2();
        print(x);
    }
    
    level1();
    print(x);
}
