// Test while loops with nested conditions
extern def print(n : int);

def print_multiples_of_three(limit : int) {
  var i = 0 : int;
  while (true) {
    if (i > limit) {
      break;
    }
    if (i % 3 == 0) {
      print(i);
    }
    i = i + 1;
  }
}

def sum_even_numbers(n : int) : int {
  var sum = 0 : int;
  var i = 0 : int;
  while (true) {
    if (i > n) {
      break;
    }
    if (i % 2 == 0) {
      sum = sum + i;
    }
    i = i + 1;
  }
  return sum;
}

def main() {
  print_multiples_of_three(10);
  print(sum_even_numbers(10));
  print(sum_even_numbers(20));
}
