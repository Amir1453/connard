extern def print(n : int);

// Test early returns from different branches
def sign(n : int) : int {
  if (n > 0) {
    return 1;
  }
  if (n < 0) {
    return -1;
  }
  return 0;
}

def abs(n : int) : int {
  if (n < 0) {
    return -n;
  }
  return n;
}

def main() {
  print(sign(42));
  print(sign(-17));
  print(sign(0));
  print(abs(42));
  print(abs(-17));
  print(abs(0));
}
