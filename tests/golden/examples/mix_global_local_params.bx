extern def print(n : int);

def global_func(x : int) : int {
    return x + 1;
}

def apply(f : function(int) -> int, x : int) : int {
    return f(x);
}

def main() {
    print(apply(global_func, 10));
    
    def local_func(x : int) : int {
        return x + 2;
    }
    
    print(apply(local_func, 10));
}
